  4.0016216874405003`*^9},ExpressionUUID->"6c1f8921-0938-4885-a112-\
e2df1e774773"],

Cell["\<\
Explique que informaci\[OAcute]n del terreno conserva la aproximaci\[OAcute]n \
L y que informaci\[OAcute]n no
puede reproducir.
R: A partir del plano verde que representa a L(x,y), podemos observar que \
conserva de manera casi id\[EAcute]ntica la altura con respecto a h(x,y) y la \
inclinaci\[OAcute]n a la que est\[AAcute] la colina mencionada cerca del \
punto (x=2, y=1), sin embargo, esta aproximaci\[OAcute]n no es del todo \
precisa puesto que no representa la curvatura y ondulaciones de dicha colina.

c)\
\>", "Text",
 CellChangeTimes->{{3.6661135517475567`*^9, 3.666113579197919*^9}, {
  3.6670001105956097`*^9, 3.667000120560849*^9}, {3.701446537487486*^9, 
  3.701446545670621*^9}, {3.732522293204924*^9, 3.732522293405016*^9}, {
  3.743528048130854*^9, 3.743528048426716*^9}, {3.8079195590845346`*^9, 
  3.807919559196822*^9}, {4.0016211898401527`*^9, 4.0016212568010197`*^9}, {
  4.001621316271047*^9, 4.001621364193933*^9}, {4.001621457718028*^9, 
  4.001621484637596*^9}, {4.0016653444971237`*^9, 4.001665394892045*^9}, {
  4.0016654331419687`*^9, 
  4.001665438527664*^9}},ExpressionUUID->"24844a33-7031-4d89-bd09-\
2e41e6b11500"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"L", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"2.3", ",", "0.8"}], "]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "2"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "->", "2"}], ",", 
          RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", "-", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "->", "2"}], ",", 
          RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0", ",", "0"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "=", 
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"L", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0", ",", "1", ",", "0"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Evaluaci\[OAcute]n", " ", "en", " ", "el", " ", "punto", " ", 
    RowBox[{"(", 
     RowBox[{"2.3", ",", " ", "0.8"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"L", "[", 
  RowBox[{"2.3", ",", "0.8"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{"2.3", ",", "0.8"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Abs", "[", 
  RowBox[{
   RowBox[{"L", "[", 
    RowBox[{"2.3", ",", "0.8"}], "]"}], "-", 
   RowBox[{"h", "[", 
    RowBox[{"2.3", ",", "0.8"}], "]"}]}], "]"}]}], "Input",
