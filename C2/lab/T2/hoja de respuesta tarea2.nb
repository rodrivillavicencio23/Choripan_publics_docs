  RowBox[{"{", 
   RowBox[{"a", ",", "c"}], "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Q2", "[", 
  RowBox[{"2.3", ",", "0.8"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{"2.3", ",", "0.8"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Abs", "[", 
  RowBox[{
   RowBox[{"Q", "[", 
