  3.807919563921237*^9}, {4.001670872274431*^9, 4.001670872461218*^9}, {
  4.00167091491436*^9, 4.00167099551086*^9}, {4.0016710320880413`*^9, 
  4.00167107848942*^9}, {4.001671125721346*^9, 4.001671258475183*^9}, {
  4.001685571908448*^9, 
  4.001685573854361*^9}},ExpressionUUID->"9f8bdeb0-d39b-467a-94b3-\
993ce58954c9"],

