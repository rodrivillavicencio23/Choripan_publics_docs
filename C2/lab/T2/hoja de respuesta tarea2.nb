Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"L", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"2", ",", "1"}], "]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "2"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "->", "2"}], ",", 
         RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"y", "-", "1"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "->", "2"}], ",", 
         RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}]}]}], ";"}], "\n", 
