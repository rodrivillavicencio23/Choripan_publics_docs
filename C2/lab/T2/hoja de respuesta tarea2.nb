Cell[TextData[{
 "Compare esta estimaci\[OAcute]n con el valor obtenido al evaluar \
directamente h(2,3, 0,8) y\ncalcule el error absoluto cometido.\n",
 StyleBox["R:  El c\[AAcute]lculo del error absoluto resulta de 0.184, un \
error muy bajo y aceptable.",
  FontWeight->"Bold"],
 "\nA partir del resultado obtenido, comente si considera razonable utilizar \
L para describir\nel terreno entre los puntos P y Q.\n",
 StyleBox["R:Considero que s\[IAcute] es razonable ocupar el punto P y Q para \
describir el terreno puesto que son valores muy cercanos entre s\[IAcute], \
adem\[AAcute]s que su error absoluto es muy bajo.",
  FontWeight->"Bold"],
 "\nd)"
}], "Text",
 CellChangeTimes->{{3.6661135517475567`*^9, 3.666113579197919*^9}, {
   3.6670001105956097`*^9, 3.667000120560849*^9}, {3.701446537487486*^9, 
   3.701446545670621*^9}, {3.732522293204924*^9, 3.732522293405016*^9}, {
   3.743528048130854*^9, 3.743528048426716*^9}, {3.807919561255485*^9, 
   3.80791956134546*^9}, {4.001667096704588*^9, 4.001667101508871*^9}, {
   4.001667140659026*^9, 4.001667141805644*^9}, 4.001667239452332*^9, {
   4.001668563459339*^9, 
   4.001668705737316*^9}},ExpressionUUID->"182413ff-24be-40b7-af1b-\
32434da152d9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Q2", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"2", ",", "1"}], "]"}], "+", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "2"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "->", "2"}], ",", 
          RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", "-", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "->", "2"}], ",", 
          RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", "2"}], ")"}], "^", "2"}], ")"}], "/", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], ",", "x"}], 
         "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "->", "2"}], ",", 
          RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"y", "-", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], ",", "y"}], 
         "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "->", "2"}], ",", 
          RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}], "+", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", "1"}], ")"}], "^", "2"}], ")"}], "/", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], ",", "y"}], 
         "]"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "->", "2"}], ",", 
          RowBox[{"y", "->", "1"}]}], "}"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0", ",", "0"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"L", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
