Cell["\<\
a) Ocuparemos una forma alternativa ocupando las funcionalidades del \
software. Graficaremos el error y veremos donde deber\[IAcute]a estar el \
optimo buscado. \
\>", "Text",
 CellChangeTimes->{{3.814649020309269*^9, 3.814649085950172*^9}, 
   3.814649714826718*^9},ExpressionUUID->"ebcd48fa-684c-42dc-b044-\
0f767128d4fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"Cos", "[", "x", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p8", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"f", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "8"}], "}"}]}], "]"}], "]"}], "/.", 
   RowBox[{"t", "\[Rule]", "x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p10", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"f", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "]"}], "/.", 
   RowBox[{"t", "\[Rule]", "x"}]}]}]}], "Input",
 CellChangeTimes->{{3.814649099084079*^9, 3.814649106448392*^9}, {
  3.8146508632879*^9, 3.814650869317224*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"826a3339-8158-4e0a-90fb-1af3175f477f"],

Cell["Graficamos el error ", "Text",
 CellChangeTimes->{{3.814649120398066*^9, 
  3.814649123998888*^9}},ExpressionUUID->"6fa686ee-692d-4c57-8740-\
7bfe4c1bf5bc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Error", "[", "x_", "]"}], ":=", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"p10", "[", "x", "]"}], "-", 
    RowBox[{"Cos", "[", "x", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Error", "[", "x", "]"}], ",", 
