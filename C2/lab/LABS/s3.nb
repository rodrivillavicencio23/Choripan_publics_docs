Cell["\<\
d) Todo lo anterior sumando que cos(x) es par. La funci\[OAcute]n fullcos \
esta definida en [-2\[Pi],2\[Pi]].\
\>", "Text",
 CellChangeTimes->{{3.8146500801721373`*^9, 3.814650080587374*^9}, {
  3.814651320271942*^9, 3.814651332555863*^9}, {3.814652326430196*^9, 
  3.814652356794365*^9}, {3.8146530697849207`*^9, 
  3.814653069862625*^9}},ExpressionUUID->"975cadcd-6044-4260-98ae-\
0257b09a05e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FullCos", "[", "x_", "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FullCosPositivo", "[", "x", "]"}], ",", 
       RowBox[{"x", "\[GreaterEqual]", " ", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FullCosPositivo", "[", 
        RowBox[{"-", "x"}], "]"}], ",", 
       RowBox[{"x", "<", "0"}]}], "}"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.814652324948314*^9, {3.814652915095429*^9, 3.814652918143533*^9}},
 CellLabel->
  "In[237]:=",ExpressionUUID->"b5fa5318-32ac-4320-a13d-f70078fb772f"],

Cell["e)", "Text",
 CellChangeTimes->{{3.814650009938582*^9, 3.81465001080429*^9}, {
  3.81465307224824*^9, 
  3.814653072315387*^9}},ExpressionUUID->"b980e3df-bfa1-4413-a5c7-\
d3fabc03544a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"shift", "[", "x_", "]"}], ":=", 
  RowBox[{"x", "-", 
   RowBox[{"2", "*", "Pi", "*", 
    RowBox[{"Floor", "[", 
     RowBox[{"x", "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "Pi"}], ")"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"shift", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"8", "*", "Pi"}]}], "}"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]}], "Input",
