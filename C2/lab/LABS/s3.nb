Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Tambien", " ", "se", " ", "puede", " ", "ocupar", " ", "Piecewise", " ", 
     "en", " ", "vez", " ", "de", " ", 
     RowBox[{"fullcos", "[", "x_", "]"}]}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"x", "\[LessEqual]", "Pi"}], ",", 
      RowBox[{"halfcos", "[", "x", "]"}], ",", 
      RowBox[{"halfcos", "[", 
       RowBox[{
        RowBox[{"2", "*", "Pi"}], "-", "x"}], "]"}]}], "]"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FullCosPositivo", "[", "x_", "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"halfcos", "[", "x", "]"}], ",", 
          RowBox[{"0", "\[LessEqual]", " ", "x", "\[LessEqual]", "Pi"}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"halfcos", "[", 
           RowBox[{
            RowBox[{"2", "*", "Pi"}], "-", "x"}], "]"}], ",", 
          RowBox[{"Pi", "<", "x", "\[LessEqual]", 
           RowBox[{"2", " ", "Pi"}]}]}], "}"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], ",", 
       RowBox[{"FullCosPositivo", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", "\"\<Expressions\>\""}]}], 
    "]"}]}]}]], "Input",
