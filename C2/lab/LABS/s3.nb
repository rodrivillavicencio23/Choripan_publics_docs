Cell[TextData[{
 "Vemos que el error es m\[AAcute]ximo en x=\[Pi]/2. El siguiente \
c\[OAcute]digo muestra que el error es menor que 5\[Times]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "7"}]], TraditionalForm]],ExpressionUUID->
  "44f461bc-3d7b-4316-8ad1-f140c0d6ef0a"],
 "."
}], "Text",
 CellChangeTimes->{{3.814649512206455*^9, 3.814649543310174*^9}, {
  3.81464959168529*^9, 
  3.814649658003889*^9}},ExpressionUUID->"bc146626-4cd2-478d-9e2c-\
ea49f352cb9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Error", "[", 
   RowBox[{"Pi", "/", "2"}], "]"}], "<", 
  RowBox[{"5", "*", 
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "7"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.814649553571468*^9, 3.814649586228671*^9}},
 CellLabel->
  "In[160]:=",ExpressionUUID->"223564c6-2a41-401b-90f3-46c64cefac8b"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.8146495617562304`*^9, 3.8146495875360193`*^9}, {
  3.8146508877028103`*^9, 3.8146509057559752`*^9}},
 CellLabel->
  "Out[160]=",ExpressionUUID->"2bbbf07f-cca6-4695-b400-443d587d1722"]
}, Open  ]],

Cell[TextData[{
 "Si vemos el gr\[AAcute]fico de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "10"], "(", "x", ")"}], TraditionalForm]],
  ExpressionUUID->"90d908c9-5f1a-4cfd-a80c-0cfba0d6bf9a"],
 " junto con Cos(x) en [0,\[Pi]/2] notaremos que la aproximaci\[OAcute]n es \
bastante buena."
}], "Text",
 CellChangeTimes->{{3.814649698538125*^9, 
  3.814649808809786*^9}},ExpressionUUID->"72447a8b-3a8d-4efb-a39c-\
08c624b1efc2"],

