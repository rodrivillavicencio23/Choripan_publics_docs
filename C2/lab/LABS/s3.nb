Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Tambien", " ", "se", " ", "puede", " ", "ocupar", " ", "Piecewise", " ", 
     "en", " ", "vez", " ", "de", " ", 
     RowBox[{"halfcos", "[", "x_", "]"}]}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"0", "\[LessEqual]", " ", "x", "\[LessEqual]", 
       RowBox[{"Pi", "/", "2"}]}], ",", 
      RowBox[{"p10", "[", "x", "]"}], ",", 
      RowBox[{"-", 
       RowBox[{"p10", "[", 
        RowBox[{"Pi", "-", "x"}], "]"}]}]}], "]"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"HalfCos", "[", "x_", "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p10", "[", "x", "]"}], ",", 
          RowBox[{"0", "\[LessEqual]", " ", "x", "\[LessEqual]", 
           RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"p10", "[", 
            RowBox[{"Pi", "-", "x"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Pi", "/", "2"}], "<", "x", "\[LessEqual]", " ", "Pi"}]}], 
         "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], ",", 
       RowBox[{"HalfCos", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", "\"\<Expressions\>\""}]}], 
    "]"}]}]}]], "Input",
