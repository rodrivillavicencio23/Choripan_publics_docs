Cell[CellGroupData[{

Cell["\<\
b) Encuentre el \[AAcute]ngulo (en radianes y en grados) entre una diagonal \
de un cubo y una de sus aristas.\
\>", "Subsection",
 CellChangeTimes->{{3.6661126902612543`*^9, 3.6661126921836195`*^9}, {
  3.6661134341282883`*^9, 3.666113488907563*^9}, {3.6661137233394594`*^9, 
