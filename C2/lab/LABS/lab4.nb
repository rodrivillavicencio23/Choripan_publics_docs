Cell[CellGroupData[{

Cell["\<\
a) Encuentre el \[AAcute]ngulo (en radianes y en grados) entre los vectores \
(2, 4, -1) y (-2, -3, 1).\
\>", "Subsection",
 CellChangeTimes->{{3.6661126902612543`*^9, 3.6661126921836195`*^9}, {
  3.6661134341282883`*^9, 3.666113488907563*^9}, {3.6661137233394594`*^9, 
  3.6661137266848316`*^9}, {3.667000135488768*^9, 3.667000136387814*^9}, {
  3.8079518541344347`*^9, 3.807951892635417*^9}, {3.807952461145582*^9, 
  3.807952461780714*^9}},ExpressionUUID->"f5d5edc6-6723-4c33-9ce8-\
25c9a7a4396e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"v1", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "4", ",", 
     RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "2"}], ",", 
     RowBox[{"-", "3"}], ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"anguloradianes", "=", 
  RowBox[{
   RowBox[{"ArcCos", "[", 
    RowBox[{
     RowBox[{"Dot", "[", 
      RowBox[{"v1", ",", "v2"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Norm", "[", "v1", "]"}], "*", 
       RowBox[{"Norm", "[", "v2", "]"}]}], ")"}]}], "]"}], "//", 
   "N"}]}], "\[IndentingNewLine]", 
 RowBox[{"angulogrados", "=", 
  RowBox[{
   RowBox[{"360", "*", 
    RowBox[{"anguloradianes", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "Pi"}], ")"}]}]}], "//", "N"}]}]}], "Input",
 CellChangeTimes->{
  3.6661135587918663`*^9, {3.6661949600010185`*^9, 3.666194982009595*^9}, {
   3.666370306414394*^9, 3.666370324815394*^9}, 3.667000122665954*^9, {
   3.668959792661642*^9, 3.668959793712512*^9}, {3.668959861500635*^9, 
