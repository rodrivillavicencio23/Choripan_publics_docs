Cell[CellGroupData[{

Cell["\<\
c) Determine la ecuaci\[OAcute]n del plano (en la forma ax + by + cz = d) que \
pasa por la l\[IAcute]nea de intersecci\[OAcute]n de los planos x + y - z = \
1, 2x + y + z = 3, y es perpendicular al plano x - 3y + 5z = 2.\
\>", "Subsection",
 CellChangeTimes->{{3.6661126902612543`*^9, 3.6661126921836195`*^9}, {
  3.6661134341282883`*^9, 3.666113488907563*^9}, {3.6661137233394594`*^9, 
  3.6661137266848316`*^9}, {3.667000135488768*^9, 3.667000136387814*^9}, {
  3.8079518541344347`*^9, 3.807951892635417*^9}, {3.807952276162094*^9, 
  3.807952302637689*^9}, {3.807952471177698*^9, 3.807952471403913*^9}, {
  3.807952529117038*^9, 3.807952653272415*^9}, {3.807952688116263*^9, 
  3.807952780488586*^9}, {3.808083256070228*^9, 3.808083299993086*^9}, {
  3.808083610363431*^9, 
  3.80808367923777*^9}},ExpressionUUID->"8446c454-1eb3-4a0a-a87c-\
4acf608c31b5"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "+", "y", "-", "z"}], "\[Equal]", "1"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"2", "x"}], "+", "y", "+", "z"}], "\[Equal]", "3"}]}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.752831883526554*^9, 3.752831884207903*^9}, 
   3.808088467359165*^9, {3.808089929490203*^9, 3.80808995242517*^9}, {
   3.808126160968555*^9, 3.8081261942226*^9}, {3.8081268848793592`*^9, 
   3.808126892246292*^9}, 3.808142366293475*^9, {3.8081424823005*^9, 
   3.808142542170786*^9}, 3.808143960012949*^9, {3.8081440394227047`*^9, 
   3.808144085149417*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"de434ef5-ba04-4904-b390-52afda7b8756"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"recta", "[", "x_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"2", "-", 
      RowBox[{"3", 
       RowBox[{"x", "/", "2"}]}]}], ",", 
     RowBox[{"1", "-", 
      RowBox[{"x", "/", "2"}]}]}], "}"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "+", "y", "-", "z"}], "\[Equal]", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "x"}], "+", "y", "+", "z"}], "\[Equal]", "3"}]}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"AxesLabel", "\[Rule]", "Automatic"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"recta", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g1", ",", "g2"}], "}"}], ",", 
   RowBox[{"BoxRatios", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.808126203499092*^9, 3.808126412899605*^9}, {
   3.808126900809573*^9, 3.808126942083454*^9}, 3.8081423703455143`*^9, {
   3.808142578335795*^9, 3.808142705157158*^9}, 3.8081439621286793`*^9, {
   3.8081441197923107`*^9, 3.808144240739336*^9}},
 CellLabel->
  "In[212]:=",ExpressionUUID->"57de2dfb-756f-4c16-b4ff-97f85e856760"],

