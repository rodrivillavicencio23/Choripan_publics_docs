    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"anguloradianes", "=", 
  RowBox[{
   RowBox[{"ArcCos", "[", 
    RowBox[{
     RowBox[{"Dot", "[", 
      RowBox[{"d", ",", "a1"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Norm", "[", "d", "]"}], "*", 
       RowBox[{"Norm", "[", "a1", "]"}]}], ")"}]}], "]"}], "//", 
   "N"}]}], "\[IndentingNewLine]", 
 RowBox[{"angulogrados", "=", 
  RowBox[{
   RowBox[{"360", "*", 
    RowBox[{"anguloradianes", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "Pi"}], ")"}]}]}], "//", "N"}]}]}], "Input",
