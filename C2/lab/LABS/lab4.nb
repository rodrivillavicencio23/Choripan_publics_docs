Cell[CellGroupData[{

Cell[TextData[{
 "c) Encuentre el \[AAcute]ngulo (en radianes y en grados) entre la recta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"x", "-", "2"}], 
     RowBox[{"-", "2"}]], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"y", "+", "4"}], "2"], "=", 
     FractionBox[
      RowBox[{"z", "-", "4"}], "4"]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "abf90635-3ee8-40e4-abfa-c2b3d01352df"],
 " y el plano x + 2y - 3z = 3."
}], "Subsection",
 CellChangeTimes->{{3.6661126902612543`*^9, 3.6661126921836195`*^9}, {
   3.6661134341282883`*^9, 3.666113488907563*^9}, {3.6661137233394594`*^9, 
   3.6661137266848316`*^9}, {3.667000135488768*^9, 3.667000136387814*^9}, {
   3.8079518541344347`*^9, 3.807951892635417*^9}, 3.807951974229393*^9, {
   3.80795202095575*^9, 3.807952024242383*^9}, {3.807952060934408*^9, 
   3.807952137837285*^9}, {3.807952468600281*^9, 
   3.807952468842573*^9}},ExpressionUUID->"4947e8b7-a74b-4717-805b-\
6cecd3afc84b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", 
     RowBox[{"-", "3"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"anguloradianes", "=", 
  RowBox[{
   RowBox[{"ArcCos", "[", 
    RowBox[{
     RowBox[{"Dot", "[", 
      RowBox[{"d", ",", "n"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Norm", "[", "d", "]"}], "*", 
       RowBox[{"Norm", "[", "n", "]"}]}], ")"}]}], "]"}], "//", "N"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"angulogrados", "=", 
   RowBox[{
    RowBox[{"180", "-", 
     RowBox[{"360", "*", 
      RowBox[{"anguloradianes", "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "Pi"}], ")"}]}]}]}], "//", "N"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "+", 
       RowBox[{"2", "y"}], "-", 
       RowBox[{"3", "z"}]}], "\[Equal]", "3"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", 
        RowBox[{"-", "4"}], ",", "4"}], "}"}], "+", 
      RowBox[{"t", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2", ",", "4"}], "}"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0", ",", "0"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g3", "=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", 
      RowBox[{"Arrow", "[", 
       RowBox[{"Tube", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{
            RowBox[{"-", "2"}], 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", 
              RowBox[{"-", "3"}]}], "}"}]}]}], "}"}], ",", "0.2"}], "]"}], 
       "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g1", ",", "g2", ",", "g3"}], "}"}], ",", 
   RowBox[{"BoxRatios", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{
