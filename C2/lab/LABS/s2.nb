Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p3", "[", "x_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", "k"}], " ", 
     RowBox[{
      RowBox[{"x", "^", 
       RowBox[{"(", 
        RowBox[{"2", " ", "k"}], ")"}]}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "k"}], ")"}], "!"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "0", ",", "3"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"Cos", "[", "1", "]"}], "-", 
    RowBox[{"p3", "[", "1", "]"}]}], "]"}], "<", 
  RowBox[{"10", "^", 
   RowBox[{"-", "3"}]}]}]}], "Input",
