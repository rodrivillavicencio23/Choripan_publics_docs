Cell[TextData[{
 "c) Necesitamos que ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "n"], "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "c272f6b9-8727-4739-bda5-cebc33d5c866"],
 " converja para x=1/2 y x=1/3 al mismo tiempo. Notemos que si ambas series \
convergen, entonces"
}], "Text",
 CellChangeTimes->{{3.702132299241171*^9, 3.702132319042452*^9}, {
  3.81470007306808*^9, 3.814700075014936*^9}, {3.814778078306747*^9, 
  3.814778096805265*^9}, {3.8147781352436113`*^9, 3.814778164021099*^9}, {
  3.8147785925448713`*^9, 
  3.814778615562004*^9}},ExpressionUUID->"f62aa4d9-2961-4e46-8523-\
7ed03d1ce595"],

Cell[TextData[{
 "ArcTan(1/2)+ArcTan(1/3)=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "\[Infinity]"], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"k", "+", "1"}]], 
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}], ")"}]}]]}], TraditionalForm]],
  ExpressionUUID->"67ce42c4-d9bd-47ee-9d1c-f0f1e8d579ba"],
 "+",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "\[Infinity]"], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"k", "+", "1"}]], 
     RowBox[{
      SuperscriptBox["3", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}], ")"}]}]]}], TraditionalForm]],
  ExpressionUUID->"a152abc2-f75c-4943-a732-7f0b31d90e48"],
 "=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "\[Infinity]"], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"k", "+", "1"}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["2", 
          RowBox[{
           RowBox[{"2", "k"}], "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "-", "1"}], ")"}]}]], "+", 
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["3", 
          RowBox[{
           RowBox[{"2", "k"}], "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "-", "1"}], ")"}]}]]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"2bdb9f6f-3152-42ed-8863-b17555c5c102"]
}], "Text",
 CellChangeTimes->{{3.814778634608345*^9, 3.814778823868948*^9}},
 TextAlignment->Center,ExpressionUUID->"2cb3e968-425a-4dba-b25f-fa4f6f644317"],

