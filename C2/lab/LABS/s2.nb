           RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "-", "Pi"}], 
      "]"}], ",", "15"}], "]"}], "\n", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
