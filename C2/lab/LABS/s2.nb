Cell["\<\
La cota del resto permite garantizar la precisi\[OAcute]n con 2000 \
t\[EAcute]rminos. Sin embargo, al calcular directamente el error se observa \
que 1000 t\[EAcute]rminos ya producen un error menor que 10^{-3}. Esto no \
contradice la estimaci\[OAcute]n anterior, ya que la cota del resto es una \
cota superior y no necesariamente coincide con el error real.\
\>", "Text",
 CellChangeTimes->{
  3.702132493604425*^9, {3.814700078513976*^9, 3.814700080494026*^9}, 
   3.8147001412852507`*^9, 3.814700574715036*^9, {3.8147774397090673`*^9, 
   3.814777512156292*^9}, {3.8147775475864*^9, 3.814777548283955*^9}, {
   3.996960767726453*^9, 
   3.996960789785224*^9}},ExpressionUUID->"5702317a-07b7-4462-aadf-\
c40fe2314ea9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"k", "+", "1"}], ")"}]}], " ", 
     RowBox[{
      RowBox[{"x", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "k"}], "-", "1"}], ")"}]}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "k"}], "-", "1"}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"4", " ", 
      RowBox[{"p", "[", 
       RowBox[{"1000", ",", "1"}], "]"}]}], "-", "Pi"}], "]"}], ",", "15"}], 
  "]"}]}], "Input",
 CellChangeTimes->{
  3.81477743807262*^9, {3.814777515962841*^9, 3.814777544549087*^9}, {
