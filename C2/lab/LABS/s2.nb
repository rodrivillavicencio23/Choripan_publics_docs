 CellLabel->"Out[23]=",ExpressionUUID->"acd1e8b3-2f86-4cc9-b050-d06173726f42"]
}, Open  ]],

Cell["\<\
De lo anterior vemos que como necesitamos que ambas series converjan, \
entonces con n\[GreaterEqual]4 ya podemos asegurar la precisi\[OAcute]n \
pedida. Podemos comprobar, \[OpenCurlyDoubleQuote]a mano\
\[CloseCurlyDoubleQuote], que con solo 2 t\[EAcute]rminos ya tenemos la \
precisi\[OAcute]n pedida. \
\>", "Text",
 CellChangeTimes->{{3.81477955798108*^9, 3.8147795618598824`*^9}, {
  3.814779652221663*^9, 3.8147796523114758`*^9}, {3.815688409449646*^9, 
  3.815688411699815*^9}},ExpressionUUID->"0a0253f1-00ee-478a-8a98-\
a6a2f63316cd"],

