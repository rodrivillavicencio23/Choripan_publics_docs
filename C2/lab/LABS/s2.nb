 " converja para x=1/5 y x=1/239 al mismo tiempo. Notemos que si ambas series \
convergen, entonces"
}], "Text",
 CellChangeTimes->{{3.702133419895211*^9, 3.702133427637683*^9}, {
  3.8147000680954447`*^9, 3.8147000703904467`*^9}, {3.814779055375111*^9, 
  3.814779076692635*^9}},ExpressionUUID->"ea827690-7494-4e8e-952d-\
ade94bb3a1b6"],

Cell[TextData[{
 "4ArcTan(1/5)-ArcTan(1/239)=4",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "\[Infinity]"], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"k", "+", "1"}]], 
     RowBox[{
      SuperscriptBox["5", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}], ")"}]}]]}], TraditionalForm]],
  ExpressionUUID->"49235e1d-056c-4690-a249-cad3513ce0c3"],
 "-",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "\[Infinity]"], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"k", "+", "1"}]], 
     RowBox[{
      SuperscriptBox["239", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}], ")"}]}]]}], TraditionalForm]],
  ExpressionUUID->"63fb109a-6603-4f84-b619-01891ac20199"],
 "=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "\[Infinity]"], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"k", "+", "1"}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["4", 
        RowBox[{
         SuperscriptBox["5", 
          RowBox[{
           RowBox[{"2", "k"}], "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "-", "1"}], ")"}]}]], "-", 
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["239", 
          RowBox[{
           RowBox[{"2", "k"}], "-", "1"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "k"}], "-", "1"}], ")"}]}]]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"4a49d859-18cc-44a8-b47c-43aed0e61d29"]
}], "Text",
 CellChangeTimes->{{3.8147790938512774`*^9, 3.814779146680081*^9}, {
  3.814779192220829*^9, 3.8147791922993793`*^9}},
 TextAlignment->Center,ExpressionUUID->"471fc551-c231-460e-b6a6-75c430869898"],

Cell[TextData[{
 "Notemos que ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["4", 
     RowBox[{
      SuperscriptBox["5", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}], ")"}]}]], "-", 
    FractionBox["1", 
     RowBox[{
      SuperscriptBox["239", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "k"}], "-", "1"}], ")"}]}]]}], TraditionalForm]],
  ExpressionUUID->"4253c6e9-03dc-4e7f-8a3d-7161bee349bb"],
 " es siempre positivo. "
}], "Text",
 CellChangeTimes->{{3.814779155240746*^9, 
  3.814779194593501*^9}},ExpressionUUID->"48aaf361-bb04-43ac-b721-\
dfecdaf27c39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"16", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "n"}], "+", "1"}], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "n"}], "+", "1"}], ")"}]}], ")"}]}], "+", 
       RowBox[{"4", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"239", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "n"}], "+", "1"}], ")"}]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "n"}], "+", "1"}], ")"}]}], ")"}]}]}], "<", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}], ",", 
     RowBox[{"n", ">=", "1"}]}], "}"}], ",", "n", ",", "Integers"}], 
  "]"}]], "Input",
 CellChangeTimes->{
  3.8147792454522953`*^9, {3.8147792992356243`*^9, 3.814779334252931*^9}, {
   3.814779463041988*^9, 3.814779477687044*^9}, 3.814779527686536*^9, {
   3.815687318620967*^9, 3.81568731886764*^9}, {3.815687544143729*^9, 
   3.8156875478101797`*^9}, {3.815688379507538*^9, 3.8156883825848293`*^9}, {
   3.996961014584382*^9, 3.9969610223586082`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"0e9c8751-8aec-46df-a0ba-d27e97af57cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", "\[Element]", 
   TemplateBox[{},
    "Integers"]}], "&&", 
  RowBox[{"n", "\[GreaterEqual]", "3"}]}]], "Output",
 CellChangeTimes->{3.815687548418943*^9, 3.815688289637822*^9, 
