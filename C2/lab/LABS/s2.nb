             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]}], " ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "5"}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "k"}], "-", "1"}], ")"}]}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "k"}], "-", "1"}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "2"}], "}"}]}], "]"}]}], "-", 
       RowBox[{"4", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"k", "+", "1"}], ")"}]}], " ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "239"}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "k"}], "-", "1"}], ")"}]}], "/", 
            RowBox[{"(", 
