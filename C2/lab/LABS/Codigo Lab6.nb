Cell[CellGroupData[{

Cell[TextData[{
 "1) Considere la funci\[OAcute]n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "(", 
     RowBox[{"x", ",", " ", "t"}], ")"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      FractionBox["1", "3"], " ", 
      RowBox[{"cos", "(", 
       RowBox[{"3", " ", "t"}], ")"}], " ", "sin", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"3", " ", "x"}], ")"}], "4"]}], " ", "+", " ", 
     RowBox[{
      FractionBox["2", "3"], " ", 
      RowBox[{"cos", "(", 
       RowBox[{"2", " ", "t"}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{"sin", "(", 
        RowBox[{"2", " ", "x"}], ")"}], "4"]}]}]}], TraditionalForm]],
  ExpressionUUID->"3522ff83-05fe-49ee-8ad9-0980ebe97882"]
}], "Section",
