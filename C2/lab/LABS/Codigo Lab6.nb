               RowBox[{"{", 
                RowBox[{"0", ",", "Pi"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}]}], "]"}], 
          ",", 
