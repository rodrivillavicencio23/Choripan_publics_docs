             RowBox[{"Point", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"u", "[", 
                 RowBox[{"1", ",", "t"}], "]"}]}], "}"}], "]"}]}], "}"}], 
           "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}]}]}], 
