Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "3"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"3", "t"}], "]"}], 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"3", "x"}], "]"}], "^", "4"}]}], "+", 
    RowBox[{
     RowBox[{"2", "/", "3"}], 
     RowBox[{"Cos", "[", 
      RowBox[{"2", "t"}], "]"}], 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"2", "x"}], "]"}], "^", "4"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "Pi"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", 
      RowBox[{"\"\<t=\>\"", "<>", 
       RowBox[{"ToString", "[", "t", "]"}]}]}], ",", 
     RowBox[{"Epilog", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"u", "[", 
            RowBox[{"1", ",", "t"}], "]"}]}], "}"}], "]"}]}], "}"}]}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0.5", ",", "1.5", ",", "0.001"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"otra", " ", "forma"}], ",", " ", 
