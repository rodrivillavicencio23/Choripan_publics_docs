Cell[BoxData[{
 RowBox[{
  RowBox[{"MyArcTan3", "[", "x_", "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p10", "[", "x", "]"}], ",", 
       RowBox[{"0", "<=", "x", "<=", "0.5"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Pi", "/", "4"}], "+", 
        RowBox[{"p10", "[", 
         RowBox[{"T", "[", "x", "]"}], "]"}]}], ",", 
       RowBox[{"0.5", "<", "x", "<=", "3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Pi", "/", "2"}], "+", 
        RowBox[{"p10", "[", 
         RowBox[{"T", "[", 
          RowBox[{"T", "[", "x", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"x", ">", "3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"MyArcTan3", "[", 
         RowBox[{"-", "x"}], "]"}]}], ",", 
       RowBox[{"x", "<", "0"}]}], "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MyArcTan3", "[", "x", "]"}], ",", " ", 
     RowBox[{"ArcTan", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", "\"\<Expressions\>\""}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MyArcTan3", "[", "x", "]"}], ",", " ", 
     RowBox[{"ArcTan", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", "\"\<Expressions\>\""}]}], "]"}], "\[IndentingNewLine]", 
