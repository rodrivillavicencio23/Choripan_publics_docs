        RowBox[{"x", ">", " ", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"MyArcTan1", "[", 
          RowBox[{"-", "x"}], "]"}]}], ",", 
        RowBox[{"x", "<", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"x", "==", "0"}]}], "}"}]}], "}"}], "]"}]}], 
