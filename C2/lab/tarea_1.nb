Cell["\<\
Podemos observar en la 1ra y 2da gr\[AAcute]fica que al llegar a x=1, la \
funci\[OAcute]n MyArcTan2 se \[OpenCurlyDoubleQuote]corta\
\[CloseCurlyDoubleQuote] en dos trazos, o sea, es discontinua, para luego \
continuar con la aproximaci\[OAcute]n a Arctan(x).\
\>", "Text",
 CellChangeTimes->{{3.999847581831913*^9, 3.99984758602815*^9}, {
  3.999971668484351*^9, 
  3.999971739821424*^9}},ExpressionUUID->"67702a19-68a7-4504-b60a-\
f8763bd61a4b"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4) Tercera estrategia: reducci\[OAcute]n adaptativa del argumento.", \
"Subsection",
 CellChangeTimes->{{3.6661128028327518`*^9, 3.666112806118081*^9}, {
  3.6661136681886272`*^9, 3.666113668258649*^9}, {3.667000187928369*^9, 
  3.667000189491858*^9}, {3.7356592640318127`*^9, 3.735659264070528*^9}, {
  3.9999701804245043`*^9, 
  3.999970190870027*^9}},ExpressionUUID->"51837828-964f-4cbb-8711-\
447c763dbbda"],

Cell[CellGroupData[{

Cell["Soluci\[OAcute]n", "Subsubsection",
 CellChangeTimes->{{3.666113672770855*^9, 3.6661136768667593`*^9}, {
  3.6670002251046877`*^9, 
  3.66700022572324*^9}},ExpressionUUID->"a25e3992-c832-47f4-ad4f-\
a9c6de5c84ca"],

Cell["\<\
A partir de la desigualdad |(x-1)/(x+1)| <= 0.5, x est\[AAcute] en el \
intervalo [1/3, 3]\
\>", "Text",
 CellChangeTimes->{{3.666370361339394*^9, 3.666370389625394*^9}, {
   3.667000222563566*^9, 3.667000223417438*^9}, {3.7014466343013773`*^9, 
   3.701446638109253*^9}, 3.735659267127849*^9, {4.000107762131448*^9, 
   4.000107820486771*^9}, 
   4.000108287553244*^9},ExpressionUUID->"57d3aaa8-ec60-43b1-9f8f-\
d83de8f6e866"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", "k"}], " ", 
     RowBox[{
      RowBox[{"x", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "k"}], "+", "1"}], ")"}]}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "k"}], "+", "1"}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p10", "[", "x_", "]"}], ":=", 
  RowBox[{"p", "[", 
   RowBox[{"10", ",", "x"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"T", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "-", "1"}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"x", "+", "1"}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{"x1", "[", "x_", "]"}], ":=", 
  RowBox[{"T", "[", "x", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x2", "[", "x_", "]"}], ":=", 
   RowBox[{"T", "[", 
    RowBox[{"x1", "[", "x", "]"}], "]"}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"A", " ", "partir", " ", "de", " ", "la", " ", "desigualdad"}], "|", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "1"}], ")"}], "/", 
      RowBox[{"(", 
